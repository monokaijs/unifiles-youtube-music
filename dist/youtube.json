{
  "id": "youtube-music",
  "name": "YouTube Music",
  "version": "3.0.0",
  "apiVersion": 2,
  "capabilities": [
    "http"
  ],
  "httpHosts": [
    "music.youtube.com",
    "www.youtube.com"
  ],
  "playbackHosts": [
    "*.googlevideo.com"
  ],
