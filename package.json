{
  "name": "unifiles-youtube-music",
  "version": "2.0.0",
  "description": "YouTube Music provider for the UniFiles JavaScript plugin API",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "monokaijs",
  "repository": {
    "type": "git",
    "url": "https://github.com/monokaijs/unifiles-youtube-music.git"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/provider.test.mjs",
    "test:types": "tsc --noEmit --strict --module NodeNext --target ES2022 tests/types.ts",
    "test:quickjs": "cargo test --locked --manifest-path tests/quickjs/Cargo.toml",
    "check": "npm run build && npm test && npm run test:types && npm run test:quickjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
